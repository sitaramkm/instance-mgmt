# ---------- General ----------
export NUM_AGENTS="1"
export SSH_USER="ubuntu"

export SERVER_NAME="server-01"
export AGENT_NAME_PREFIX="agent"

# ---------- Multipass ----------
export UBUNTU_VER="24.04"
export VM_CPUS="2"
export VM_MEM="2G"
export VM_DISK="20G"

# ---------- LLM / AI sizing ----------
export AGENT_VM_CPUS="4"
export AGENT_VM_MEM="8G"
export AGENT_VM_DISK="40G"

# ---------- AWS ----------
export AWS_PROFILE="${AWS_PROFILE:-sitaram}"
export AWS_REGION="${AWS_REGION:-us-east-2}"
export AMI_ID="${AMI_ID:-ami-04f167a56786e4b09}"
export INSTANCE_TYPE="${INSTANCE_TYPE:-t3.small}"
export AGENT_INSTANCE_TYPE_AI="g5.xlarge"
export DISK_GB="20"
