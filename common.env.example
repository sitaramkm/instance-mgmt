# ---------- General ----------
export SSH_USER="ubuntu"

export SERVER_NAME="server-01"
export AGENT_NAME="agent-01"

# ---------- Multipass ----------
export UBUNTU_VER="24.04"
export VM_CPUS="2"
export VM_MEM="2G"
export VM_DISK="20G"

# ---------- LLM / AI sizing ----------
export AGENT_VM_CPUS="4"
export AGENT_VM_MEM="8G"
export AGENT_VM_DISK="40G"

# ---------- AWS ----------
export AWS_PROFILE="${AWS_PROFILE:-sitaram}"
export AWS_REGION="${AWS_REGION:-us-east-2}"
export AMI_ID="${AMI_ID:-ami-04f167a56786e4b09}"
export INSTANCE_TYPE="${INSTANCE_TYPE:-t3.small}"
export AGENT_INSTANCE_TYPE_AI="g5.xlarge"
export DISK_GB="20"
# Optional – if not set, a public subnet from the default VPC is used
# export SUBNET_ID="subnet-xxxxxxxx"


# ------------------------------------------------------------
# GCP
# ------------------------------------------------------------
export GCP_PROJECT_ID="REPLACE_WITH_YOUR_PROJECT_ID"
export GCP_REGION="us-central1"
# Ordered list of zones to try (space-separated)
export GCP_ZONES="us-central1-b us-central1-c us-west4-b"
# Default machine types
export GCP_INSTANCE_TYPE="e2-standard-2"


# GCP Ubuntu image families (architecture-specific)
export GCP_IMAGE_FAMILY_AMD64="ubuntu-2404-lts-amd64"
export GCP_IMAGE_FAMILY_ARM64="ubuntu-2404-lts-arm64"
export GCP_IMAGE_PROJECT="ubuntu-os-cloud"

# ------------------------------------------------------------
# For AI / LLM agents
# ------------------------------------------------------------
# CPU-based "AI" agents (recommended default)
export GCP_AGENT_INSTANCE_TYPE_AI="c2-standard-8"
# Optional GPU type (only if explicitly enabled later)
export GCP_AGENT_INSTANCE_TYPE_GPU="g2-standard-4"
export GCP_AGENT_DISK_GB="40"
